rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /config/app {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == "nd9zWE3GF2hOJDg4BfgTtaSy3H33";
    }


    match /config/areas {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == "nd9zWE3GF2hOJDg4BfgTtaSy3H33";
    }

    match /config/update {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == "nd9zWE3GF2hOJDg4BfgTtaSy3H33";
    }

    /*
     * DADOS PRIVADOS DA CONTA
     *
     * O usuário pode ler/escrever somente o próprio documento.
     * O proprietário continua podendo consultar os usuários no ADM.
     */
    match /usuarios/{uid} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid;

      allow read: if request.auth != null
        && (
          request.auth.uid == uid
          || request.auth.uid == "nd9zWE3GF2hOJDg4BfgTtaSy3H33"
        );

      allow delete: if request.auth != null
        && request.auth.uid == "nd9zWE3GF2hOJDg4BfgTtaSy3H33";
    }

    /*
     * PERFIS PÚBLICOS
     *
     * Não contém UID, e-mail ou dados internos como campos públicos.
     * O UID usado no caminho do documento é interno e não é exibido
     * pela interface.
     *
     * Leitura pública somente para usuários autenticados.
     */
    match /perfis_publicos/{uid} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid;

      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }

    /*
     * CONVITES
     *
     * Cada usuário pode criar/alterar seus próprios convites enviados
     * e o destinatário pode ler os recebidos.
     */
    match /convites/{destinatarioUid}/recebidos/{remetenteUid} {
      allow create: if request.auth != null
        && request.auth.uid == remetenteUid;

      allow read: if request.auth != null
        && (
          request.auth.uid == destinatarioUid
          || request.auth.uid == remetenteUid
        );

      allow update, delete: if request.auth != null
        && (
          request.auth.uid == destinatarioUid
          || request.auth.uid == remetenteUid
        );
    }

    /*
     * CONEXÕES
     * Cada usuário acessa somente sua própria lista.
     * Os UIDs permanecem internos no Firestore.
     */
    match /conexoes/{uid}/usuarios/{outroUid} {
      allow read: if request.auth != null
        && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid;

      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }

    match /have_usuarios/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid;

      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }

    match /have_perfis_publicos/{uid} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid;

      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }


    // =========================
    // GRUPOS
    // =========================

    // CHAT PRIVADO: somente os dois participantes da conversa.
    match /chats/{conversaId} {
      function conexoesAceitas(uidA, uidB) {
        return exists(
          /databases/$(database)/documents/conexoes/$(uidA)/usuarios/$(uidB)
        ) && exists(
          /databases/$(database)/documents/conexoes/$(uidB)/usuarios/$(uidA)
        );
      }

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['participantes'])
        && request.resource.data.participantes is list
        && request.resource.data.participantes.size() == 2
        && request.auth.uid in request.resource.data.participantes
        && conexoesAceitas(
             request.resource.data.participantes[0],
             request.resource.data.participantes[1]
           )
        && request.resource.data.participantes[0]
             < request.resource.data.participantes[1]
        && conversaId == request.resource.data.participantes[0]
             + '_' + request.resource.data.participantes[1];

      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantes
        && conexoesAceitas(
             resource.data.participantes[0],
             resource.data.participantes[1]
           );

      // Não permite trocar os participantes depois da criação.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantes
        && request.resource.data.participantes
             == resource.data.participantes
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['participantes']);

      allow delete: if false;

      match /mensagens/{mensagemId} {
        function conversa() {
          return get(
            /databases/$(database)/documents/chats/$(conversaId)
          );
        }

        allow read: if request.auth != null
          && request.auth.uid in conversa().data.participantes
          && conexoesAceitas(
               conversa().data.participantes[0],
               conversa().data.participantes[1]
             );

        allow create: if request.auth != null
          && request.auth.uid in conversa().data.participantes
          && conexoesAceitas(
               conversa().data.participantes[0],
               conversa().data.participantes[1]
             )
          && request.resource.data.keys().hasOnly([
               'remetenteUid', 'destinatarioUid',
               'texto', 'tipo', 'criadoEm'
             ])
          && request.resource.data.remetenteUid == request.auth.uid
          && request.resource.data.destinatarioUid
               in conversa().data.participantes
          && request.resource.data.destinatarioUid != request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.tipo == 'texto';

        allow update: if false;

        allow delete: if request.auth != null
          && request.auth.uid == resource.data.remetenteUid
          && request.auth.uid in conversa().data.participantes;
      }
    }

    match /grupos/{grupoId} {

      // Apenas participantes podem visualizar o grupo.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantes;

      // Apenas usuário autenticado pode criar um grupo,
      // sendo obrigatoriamente o administrador inicial.
      allow create: if request.auth != null
        && request.resource.data.administradorUid == request.auth.uid
        && request.auth.uid in request.resource.data.participantes;

      // Apenas participantes podem atualizar o grupo.
      // Alterações administrativas ficam restritas ao administrador.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.administradorUid;

      // Somente o administrador pode excluir o grupo.
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.administradorUid;


      // =========================
      // MENSAGENS DO GRUPO
      // =========================
      match /mensagens/{mensagemId} {

        // Apenas participantes do grupo podem ler mensagens.
        allow read: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/grupos/$(grupoId)
          ).data.participantes;

        // Somente participante pode enviar mensagem
        // e o remetente precisa ser o próprio usuário autenticado.
        allow create: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/grupos/$(grupoId)
          ).data.participantes
          && request.resource.data.remetenteUid == request.auth.uid;

        // Mensagens não poderão ser alteradas por enquanto.
        allow update: if false;

        // Somente o próprio remetente poderá excluir sua mensagem.
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.remetenteUid;
      }
    }

    // --- REGRA EQUIPE - DaNikeAI ---
match /equipe/{equipeId} {
allow read: if request.auth != null;
allow create, update, delete: if request.auth != null && request.auth.uid == "nd9zWE3GF2hOJDg4BfgTtaSy3H33";
}

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
