}


    class NeonBackground extends View {

        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
        float fase = 0;
        ArrayList<Particle> particulas = new ArrayList<>();

        NeonBackground(android.content.Context c) {
            super(c);

            for (int i = 0; i < 26; i++) {
                particulas.add(new Particle(
                        (float)Math.random(),
                        (float)Math.random(),
                        1 + (float)Math.random() * 3,
                        0.4f + (float)Math.random()
                ));
            }

            postInvalidateDelayed(30);
        }

        @Override
        protected void onDraw(Canvas c) {
            super.onDraw(c);

            float w = getWidth();
            float h = getHeight();

            p.setStyle(Paint.Style.FILL);
            p.setColor(Color.rgb(1, 3, 12));
            c.drawRect(0, 0, w, h, p);

            fase += 0.006f;

            // LINHAS NEON ANIMADAS
            p.setStyle(Paint.Style.STROKE);
            p.setStrokeWidth(dp(1.3f));

            for (int i = -3; i < 12; i++) {

                float y =
                        ((i * dp(95)) + fase * dp(500))
                        % (h + dp(200))
                        - dp(100);

                p.setColor(Color.argb(75, 0, 130, 255));

                Path linha = new Path();

                linha.moveTo(-dp(80), y);

                linha.cubicTo(
                        w * .25f,
                        y - dp(70),
                        w * .70f,
                        y + dp(100),
                        w + dp(100),
                        y - dp(40)
                );

                c.drawPath(linha, p);
            }

            // LINHAS DIAGONAIS
            for (int i = 0; i < 8; i++) {

                float x = (i + .5f) * w / 8f;

                p.setColor(Color.argb(35, 0, 220, 255));

                c.drawLine(
                        x,
                        0,
                        x - dp(80),
                        h,
                        p
                );
            }

            // PARTÍCULAS
            p.setStyle(Paint.Style.FILL);

            for (Particle q : particulas) {

                q.y -= 0.0012f * q.vel;

                q.x += Math.sin(fase * 3 + q.y * 8) * 0.0007f;

                if (q.y < 0) {
                    q.y = 1;
                    q.x = (float)Math.random();
                }

                float x = q.x * w;
                float y = q.y * h;

                p.setColor(Color.argb(190, 0, 210, 255));

                p.setShadowLayer(
                        dp(8),
                        0,
                        0,
                        Color.rgb(0, 210, 255)
                );

                c.drawCircle(
                        x,
                        y,
                        dp(q.tamanho),
                        p
                );

                p.clearShadowLayer();
            }

            postInvalidateDelayed(30);
        }
    }


    class Particle {

        float x;
        float y;
        float tamanho;
        float vel;

        Particle(
                float x,
                float y,
                float tamanho,
                float vel
        ) {
            this.x = x;
            this.y = y;
            this.tamanho = tamanho;
            this.vel = vel;
        }
    }


    class NeonFaceStage extends View {

        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);

        float angulo = 0;

        NeonFaceStage(android.content.Context c) {
            super(c);
            postInvalidateDelayed(30);
        }

        @Override
        protected void onDraw(Canvas c) {

            super.onDraw(c);

            float cx = getWidth() / 2f;
            float cy = getHeight() / 2f;

            float r =
                    Math.min(
                            getWidth(),
                            getHeight()
                    ) * .40f;

            angulo += 0.8f;

            // CÍRCULO PRINCIPAL
            p.setStyle(Paint.Style.STROKE);
            p.setStrokeWidth(dp(2));

            p.setColor(
                    Color.argb(
                            180,
                            0,
                            220,
                            255
                    )
            );

            p.setShadowLayer(
                    dp(18),
                    0,
                    0,
                    Color.rgb(0, 220, 255)
            );

            c.drawCircle(
                    cx,
                    cy,
                    r,
                    p
            );

            p.clearShadowLayer();

            // ANEL DOURADO
            p.setStrokeWidth(dp(1));

            p.setColor(
                    Color.argb(
                            160,
                            255,
                            190,
                            30
                    )
            );

            c.drawCircle(
                    cx,
                    cy,
                    r * 1.08f,
                    p
            );

            // ARCOS DE ENERGIA
            p.setStrokeWidth(dp(4));

            p.setColor(
                    Color.rgb(
                            0,
                            220,
                            255
                    )
            );

            RectF arco = new RectF(
                    cx - r * 1.15f,
                    cy - r * 1.15f,
                    cx + r * 1.15f,
                    cy + r * 1.15f
            );

            c.drawArc(
                    arco,
                    angulo,
                    90,
                    false,
                    p
            );

            p.setColor(
                    Color.rgb(
                            255,
                            190,
                            30
                    )
            );

            c.drawArc(
                    arco,
                    angulo + 180,
                    65,
                    false,
                    p
            );

            // ORBES GIRANDO
            for (int i = 0; i < 8; i++) {

                double a =
                        Math.toRadians(
                                angulo * .8 + i * 45
                        );

                float raio = r * 1.18f;

                float x =
                        cx +
                        (float)Math.cos(a) * raio;

                float y =
                        cy +
                        (float)Math.sin(a) * raio;

                boolean dourado = i % 3 == 0;

                int cor = dourado
                        ? Color.rgb(255, 190, 30)
                        : Color.rgb(0, 220, 255);

                p.setStyle(Paint.Style.FILL);

                p.setColor(cor);

                p.setShadowLayer(
                        dp(12),
                        0,
                        0,
                        cor
                );

                c.drawCircle(
                        x,
                        y,
                        dp(dourado ? 5 : 4),
                        p
                );

                p.clearShadowLayer();
            }

            postInvalidateDelayed(30);
        }
    }

    
    TextView texto(String s, float tamanho, int cor, boolean negrito) {
        TextView t = texto(s, tamanho, cor);

        if (negrito) {
            t.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        }

        return t;
    }

    GradientDrawable fundo(int cor) {
        return fundo(cor, dp(18));
    }


}
