    // ENTER / ENVIAR
    entrada.setOnEditorActionListener(
            (v, action, event) -> {
                if (action == EditorInfo.IME_ACTION_SEND
                        || (event != null
                        && event.getKeyCode()
                        == KeyEvent.KEYCODE_ENTER)) {
                    responder();
                    return true;
                }
                return false;
