    private void prepararConversa() {
        if (meuUid == null || meuUid.trim().isEmpty()
                || outroUid == null || outroUid.trim().isEmpty()
                || meuUid.equals(outroUid)) {
            Toast.makeText(
                    this,
                    "Não foi possível identificar os participantes.",
                    Toast.LENGTH_LONG
            ).show();
            finish();
            return;
        }

        String conversaId = gerarIdConversa();
        List<String> participantes = new ArrayList<>();

        if (meuUid.compareTo(outroUid) < 0) {
            participantes.add(meuUid);
            participantes.add(outroUid);
        } else {
            participantes.add(outroUid);
            participantes.add(meuUid);
        }

        com.google.firebase.firestore.DocumentReference ref =
                db.collection("chats").document(conversaId);

        // Primeiro verifica se a conversa já existe.
        // Não tenta regravar um documento existente ao abrir o chat.
        ref.get()
                .addOnSuccessListener(documento -> {
                    if (isFinishing() || isDestroyed()) return;

                    if (documento.exists()) {
                        Object valor = documento.get("participantes");

                        if (valor instanceof List
                                && participantes.equals(valor)
                                && participantes.contains(meuUid)) {
                            db.collection("chats")
                                    .document(conversaId)
                                    .update("naoLidas_" + meuUid, 0)
                                    .addOnCompleteListener(resultado -> iniciarMensagens());
                        } else {
                            Toast.makeText(
                                    this,
                                    "A conversa existente tem dados incompatíveis. "
                                            + "Ela não foi alterada.",
                                    Toast.LENGTH_LONG
                            ).show();
                        }
                        return;
                    }

                    Map<String, Object> dadosConversa = new HashMap<>();
                    dadosConversa.put("participantes", participantes);

                    // Criação apenas quando o documento ainda não existe.
                    ref.set(dadosConversa)
                            .addOnSuccessListener(v -> {
                                if (!isFinishing() && !isDestroyed()) {
                                    db.collection("chats")
                                    .document(conversaId)
                                    .update("naoLidas_" + meuUid, 0)
                                    .addOnCompleteListener(resultado -> iniciarMensagens());
                                }
                            })
                            .addOnFailureListener(e -> {
                                android.util.Log.e(
                                        "DaNikeAI",
                                        "Falha ao criar conversa " + conversaId,
                                        e
                                );
                                Toast.makeText(
                                        this,
                                        "Não foi possível criar a conversa. "
                                                + "Verifique se os dois usuários "
                                                + "estão conectados.",
                                        Toast.LENGTH_LONG
                                ).show();
                            });
                })
                .addOnFailureListener(e -> {
                    android.util.Log.e(
                            "DaNikeAI",
                            "Falha ao consultar conversa " + conversaId,
                            e
                    );
                    Toast.makeText(
                            this,
                            "Não foi possível verificar a conversa. "
                                    + "Confira sua conexão e permissões.",
                            Toast.LENGTH_LONG
                    ).show();
                });
    }

    private void iniciarMensagens() {
        iniciarListenerDigitando();

        String conversaId =
                gerarIdConversa();

        listenerMensagens =
                db.collection("chats")
                        .document(conversaId)
                        .collection("mensagens")
                        .orderBy(
                                "criadoEm",
                                Query.Direction.ASCENDING
                        )
                        .addSnapshotListener(
                                (snapshot, error) -> {

                            if (error != null ||
                                    snapshot == null) {
                                return;
                            }

                            listaMensagens.removeAllViews();
                            ultimaDataExibida = "";

                            indicadorDigitando = null;
                            pontosDigitando = null;

                            for (DocumentSnapshot doc :
                                    snapshot.getDocuments()) {

                                String remetente =
                                        doc.getString(
                                                "remetenteUid"
                                        );

                                String texto =
                                        doc.getString("texto");

                                if (texto == null) {
                                    texto = "";
                                }

                                boolean mensagemMinha =
                                        meuUid.equals(remetente);

                                if (!mensagensCarregadas
                                        && !mensagemMinha) {
                                    ultimaMensagemNotificada =
                                            doc.getId();
                                }

                                if (mensagensCarregadas
                                        && !mensagemMinha
                                        && !doc.getId().equals(
                                                ultimaMensagemNotificada)) {

                                    ultimaMensagemNotificada =
                                            doc.getId();

                                    android.util.Log.d(
                                            "DaNikeNotificacao",
                                            "NOVA_MENSAGEM_RECEBIDA: "
                                                    + texto
                                    );

                                    mostrarNotificacaoMensagemLocal(
                                            texto
                                    );
                                }

                                adicionarMensagem(
                                        doc,
                                        texto,
                                        mensagemMinha
                                );
                            }

                            mensagensCarregadas = true;

                            if (outroEstaDigitando) {
                                mostrarIndicadorDigitando(true);
                            }

                            marcarMensagensComoLidas();
                            scroll.post(() -> {
                                scroll.fullScroll(View.FOCUS_DOWN);

                                scroll.postDelayed(() ->
                                        scroll.fullScroll(View.FOCUS_DOWN),
                                        120
                                );
                            });
                        }
                        );
    }

    private void marcarMensagensComoLidas() {
        if (meuUid == null || meuUid.trim().isEmpty()) {
            return;
        }

        String conversaId = gerarIdConversa();

        db.collection("chats")
                .document(conversaId)
                .collection("mensagens")
                .whereEqualTo("destinatarioUid", meuUid)
                .get()
                .addOnSuccessListener(snapshot -> {
                    WriteBatch batch = db.batch();
                    boolean encontrou = false;

                    for (DocumentSnapshot doc : snapshot.getDocuments()) {
                        Boolean lida = doc.getBoolean("lida");

                        if (!Boolean.TRUE.equals(lida)) {
                            batch.update(
                                    doc.getReference(),
                                    "lida",
                                    true
                            );
                            encontrou = true;
                        }
                    }

                    if (encontrou) {
                        batch.commit();
                    }
                });
    }

