        <activity android:name=".ConfiguracoesActivity" android:exported="false" />

        <!-- ABERTURA -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- LOGIN -->
    <activity android:name=".OnboardingActivity" android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- CADASTRO -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- TELA PRINCIPAL -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- TELA DA INTELIGÊNCIA ARTIFICIAL -->
        <activity
            android:name=".IAActivity"
            android:exported="false" />

        <activity
            android:name=".HistoricoActivity"
            android:exported="false" />

        <activity
            android:name=".PerfilActivity"
