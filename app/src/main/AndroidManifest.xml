        <activity android:name=".ChatIndividualActivity" android:exported="false" />

            <activity android:name=".filmes.FilmesActivity" android:exported="false" />
            <activity android:name=".filmes.VideoActivity" android:exported="false" />
            <activity android:name=".MemoriasActivity" android:exported="false" />
        <activity android:name=".ConversasActivity" android:exported="false" />
        <service
    android:name=".DaNikeBackgroundService"
    android:exported="false"
    android:foregroundServiceType="microphone" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".DaNikeFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
